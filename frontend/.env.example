# Public API origin; /api/v1 is appended by the HTTP adapter.
# Maps the shared logical FRONTEND_API_BASE_URL setting.
# Browser and API must use the same hostname for SameSite cookies (localhost with localhost).
# Backend FRONTEND_ORIGIN must match the browser URL, including its port.
VITE_API_URL=http://localhost:8000
VITE_USE_MOCK=true

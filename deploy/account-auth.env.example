# Public Firebase web configuration, supplied at runtime rather than baked into JS.
# Generate deploy/account-auth.env with scripts/configure_google_auth.py.
export FIREBASE_PROJECT_ID=project-0021b03b-28bd-43e6-9d4
export FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
export FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
export FIREBASE_APP_ID=YOUR_FIREBASE_WEB_APP_ID

# Reference only. The deployment script supplies these non-secret settings.
ENVIRONMENT=production
EVIDENCE_STORAGE_BACKEND=gcs
EVIDENCE_GCS_BUCKET=YOUR_PROJECT_ID-bindr-evidence
AI_PROVIDER=meta
META_MODEL=muse-spark-1.3
META_BASE_URL=https://api.meta.ai/v1
META_TIMEOUT=45
SESSION_LIFETIME_SECONDS=2592000
# Secret Manager, pinned to explicit numeric versions:
# AUTH_SECRET -> bindr-auth-secret:1 (random, at least 32 characters)
# DATABASE_URL -> bindr-database-url:1
#   postgresql+psycopg://bindr:URL_ENCODED_PASSWORD@/bindr?host=/cloudsql/PROJECT:REGION:bindr-db
# MODEL_API_KEY -> bindr-model-api-key:1 (existing Meta provider key)
# No GOOGLE_APPLICATION_CREDENTIALS file: use the Cloud Run service identity.

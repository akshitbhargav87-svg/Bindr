# Meta Model API Configuration for Promise Keeper (Bindr)
# Copy this file to .env and fill in your actual API credentials

# Required for production Meta Model API
MODEL_API_KEY=your_meta_model_api_key_here

# Optional: Default Meta Model API endpoint (default: https://api.meta.ai/v1)
META_BASE_URL=https://api.meta.ai/v1

# Optional: Model identifier (default: muse-spark-1.3)
META_MODEL=muse-spark-1.3

# Optional: Provider override ('meta' or 'mock', default: auto-detect)
AI_PROVIDER=meta
